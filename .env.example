# ---------------------------------------------------------------
# AresNav environment configuration
# Copy to .env in the repository root:   copy .env.example .env
# Never commit .env. Full descriptions: docs/API_CONTRACTS.md §7
# ---------------------------------------------------------------

# --- General ---
ARESNAV_ENV=development
ARESNAV_LOG_LEVEL=INFO

# --- API server ---
ARESNAV_API_HOST=127.0.0.1
ARESNAV_API_PORT=8000
ARESNAV_CORS_ORIGINS=http://localhost:5173

# --- Data ---
# Relative paths resolve against the repository root.
ARESNAV_DATA_DIR=backend/data
ARESNAV_DEFAULT_REGION=gale_mount_sharp

# --- Routing limits ---
ARESNAV_MAX_GRID_CELLS=4000000
ARESNAV_ROUTE_TIMEOUT_S=30

# --- Optional LLM (default: none = deterministic mode) ---
# Provider: none | anthropic | openai
ARESNAV_LLM_PROVIDER=none
# Model name, required when the provider is not "none"
ARESNAV_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARESNAV_AGENT_NODE_TIMEOUT_S=30

# --- Optional tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Frontend (put in frontend/.env.local, not here) ---
# Empty = same origin through the Vite dev proxy.
# VITE_API_BASE_URL=
