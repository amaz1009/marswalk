# ---------------------------------------------------------------
# MARSWALK environment configuration
# Copy to .env in the repository root:   copy .env.example .env
# Never commit .env. Full descriptions: docs/API_CONTRACTS.md §7
# ---------------------------------------------------------------

# --- General ---
MARSWALK_ENV=development
MARSWALK_LOG_LEVEL=INFO

# --- API server ---
MARSWALK_API_HOST=127.0.0.1
MARSWALK_API_PORT=8000
MARSWALK_CORS_ORIGINS=http://localhost:5173

# --- Data ---
# Relative paths resolve against the repository root.
MARSWALK_DATA_DIR=backend/data
MARSWALK_DEFAULT_REGION=gale_mount_sharp

# --- Routing limits ---
MARSWALK_MAX_GRID_CELLS=4000000
MARSWALK_ROUTE_TIMEOUT_S=20

# --- Optional LLM (default: none = deterministic mode) ---
# Provider: none | anthropic | openai
MARSWALK_LLM_PROVIDER=none
# Model name, required when the provider is not "none"
MARSWALK_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MARSWALK_AGENT_NODE_TIMEOUT_S=30

# --- Optional tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Frontend (put in frontend/.env.local, not here) ---
# Empty = same origin through the Vite dev proxy.
# VITE_API_BASE_URL=
