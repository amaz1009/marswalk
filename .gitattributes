# Normalise line endings: LF in the repository and working tree,
# except Windows scripts, which keep CRLF.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.tif binary
*.tiff binary
*.IMG binary
*.img binary
*.jp2 binary
*.zip binary
*.woff binary
*.woff2 binary
