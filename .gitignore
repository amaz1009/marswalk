# ---------------------------------------------------------------
# MARSWALK .gitignore
# ---------------------------------------------------------------

# --- Secrets and local configuration ---
.env
.env.*
!.env.example
frontend/.env.local
frontend/.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*

# --- Scientific data (large; recreated by backend/scripts) ---
# Manifests and region configs ARE committed.
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
backend/data/renders/*
!backend/data/renders/.gitkeep
backend/data/surface_images/*
!backend/data/surface_images/.gitkeep

# Raster and archive formats anywhere in the repo (test fixtures are generated by code)
*.IMG
*.img
*.LBL
*.lbl
*.tif
*.tiff
*.TIF
*.jp2
*.JP2
*.cub
*.zip
*.tar
*.tar.gz
*.gz

# --- Logs ---
*.log
logs/

# --- Editors and OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
